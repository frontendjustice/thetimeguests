      "items": [
        { "type": "char", "id": "hitler", "x": 0.3, "y": 0.74, "outfit": "military", "color": "#7a7a63", "hair": "side", "mustache": "toothbrush", "face": "right", "mood": "smug", "at": 0, "enter": "left",
