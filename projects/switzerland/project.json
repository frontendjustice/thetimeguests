          { "coords": [[7.0, 46.6], [7.6, 46.85], [8.3, 46.98], [9.2, 46.95], [9.7, 46.6], [9.1, 46.3], [8.4, 46.2], [7.7, 46.05], [7.0, 46.25]], "color": "#ffffff", "opacity": 0.55, "at": "Alps" }
        ]
