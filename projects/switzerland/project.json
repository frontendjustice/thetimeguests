    {
      "say": "On top of that, Swiss banks quietly bought German gold, and paid in Swiss francs that Germany used to buy war materials abroad.",
      "bg": { "type": "room", "wall": "#dfe6dc", "floor": "#6b4a32", "props": ["lamp", { "type": "frame", "x": 0.5, "y": 0.12, "color": "#2f4a3a" }, { "type": "desk", "x": 0.5, "w": 620 }] },
      "items": [
        { "type": "char", "id": "banker", "x": 0.7, "y": 0.74, "outfit": "suit", "color": "#2b2f36", "tie": "#c0392b", "hair": "bald", "glasses": true, "face": "left", "hat": "fedora", "at": 0, "enter": "right", "mood": "smug",
          "poses": [{ "at": 0, "pose": "down" }, { "at": "paid", "pose": "hold" }], "hold": "money" },
        { "type": "char", "id": "hitler3", "x": 0.28, "y": 0.74, "outfit": "military", "color": "#7a7a63", "hair": "side", "mustache": "toothbrush", "face": "right", "at": "German", "enter": "left", "mood": "happy",
          "poses": [{ "at": 0, "pose": "hold" }], "hold": "gold" },
