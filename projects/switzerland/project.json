        { "type": "label", "pos": [8.35, 46.55], "text": "THE REDOUBT", "size": 64, "at": "fortress", "color": "#ffe11a" },
        { "type": "boom", "pos": [9.3, 46.25], "at": "explosives", "size": 0.5 },
        { "type": "char", "id": "guisan", "x": 0.25, "y": 0.82, "outfit": "military", "color": "#4d5b7a", "hat": "kepi", "hatColor": "#3b4d7a", "hair": "white", "mustache": "walrus", "hairColor": "#ddd", "face": "right", "at": "Guisan", "enter": "left", "scale": 0.85,
          "poses": [{ "at": 0, "pose": "down" }, { "at": "pulled", "pose": "point" }], "mood": "smug" }
      ]
