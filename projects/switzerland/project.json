    {
      "say": "The message to Berlin was clear. Invade, and every road and railway you actually want gets blown to pieces.",
      "bg": { "type": "field", "palette": "grass", "seed": "alps", "craters": 2 },
      "items": [
        { "type": "char", "id": "guisan2", "x": 0.3, "y": 0.74, "outfit": "military", "color": "#4d5b7a", "hat": "kepi", "hatColor": "#3b4d7a", "hair": "white", "mustache": "walrus", "hairColor": "#ddd", "face": "right", "at": 0, "enter": "none",
          "poses": [{ "at": 0, "pose": "point" }, { "at": "blown", "pose": "shrug" }], "mood": "smug",
          "say": [{ "text": "Go ahead. Try it.", "at": "Invade" }] },
