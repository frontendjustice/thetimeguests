          { "countries": ["Switzerland"], "color": "#ffffff", "at": 0, "fade": 0 },
          { "countries": ["Switzerland"], "color": "#e53935", "at": "neutral", "fade": 0.6 }
        ] },
      "items": [
        { "type": "flagpole", "pos": [8.2, 46.85], "flag": "white", "at": "neutral", "scale": 1.3 },
        { "type": "check", "pos": [9.3, 46.35], "at": "worth", "scale": 1.3 },
