          "say": [{ "text": "Switzerland... how hard can it be?", "at": "want" }] },
        { "type": "char", "id": "general", "x": 0.74, "y": 0.76, "outfit": "military", "color": "#5d6650", "hat": "cap", "hatColor": "#5d6650", "hair": "short", "glasses": true, "face": "left", "medals": true, "at": "army", "enter": "right", "hold": "paper",
