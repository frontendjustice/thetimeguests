          "moods": [{ "at": 0, "mood": "neutral" }, { "at": "blown", "mood": "shocked" }] },
        { "type": "boom", "x": 0.5, "y": 0.3, "at": "blown", "size": 1.2 },
        { "type": "boom", "x": 0.18, "y": 0.26, "at": "pieces", "size": 0.8 },
        { "type": "boom", "x": 0.84, "y": 0.28, "at": "pieces+0.25", "size": 0.9 }
      ]
    },
    {
      "say": "And Germany needed those railways. The Gotthard and Simplon tunnels were its fastest link to its ally, Italy.",
      "bg": {
        "type": "map",
        "view": [{ "at": 0, "lon": 9.3, "lat": 47.0, "span": 9 }],
        "fills": [
          { "countries": ["Switzerland"], "color": "#e53935", "at": 0, "fade": 0 },
          { "countries": ["Germany", "Austria", "France"], "color": "#8e44ad", "at": 0, "fade": 0 },
          { "countries": ["Italy"], "color": "#2e9e5b", "at": "Italy", "opacity": 1 }
        ]
      },
      "items": [
        { "type": "marker", "pos": [8.59, 46.6], "label": "Gotthard", "at": "Gotthard", "color": "#ffe11a" },
